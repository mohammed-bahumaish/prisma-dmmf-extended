{
  "name": "@mohammed-bahumaish/prisma-dmmf-extended",
  "version": "1.0.1",
  "description": "An extension library for Prisma's DMMF (Data Model Meta Format) that provides bidirectional conversion between Prisma schema and DMMF",
  "license": "MIT",
  "author": "Mohammed Bahumaish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammed-bahumaish/prisma-dmmf-extended.git"
  },
  "keywords": [
    "prisma",
    "dmmf",
    "schema",
    "conversion",
    "zenstack"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf node_modules dist",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@prisma/engine-core": "^4.10.1",
    "@prisma/generator-helper": "^4.10.1",
    "@prisma/internals": "^4.10.1",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "strip-ansi": "^7.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.15.10",
    "eslint": "^8.34.0",
    "jest": "^29.5.0",
    "prisma": "^5.2.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "tsup": "^6.6.3",
    "tsx": "^3.12.3",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
